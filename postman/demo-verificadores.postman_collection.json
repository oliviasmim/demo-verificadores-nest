    {
      "name": "3. Cenários BDD",
      "description": "Verificam o comportamento ESPERADO descrito em docs/specs/SPEC-usuarios-autenticacao.md (seção de cenários pendentes). Rode esta pasta por último: o cenário de apagar altera dados.",
      "item": [
        {
          "name": "Cenário: cadastro com e-mail já cadastrado é recusado",
          "item": [
            {
              "name": "Cadastrar ana@pda.org de novo",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"cadastro com e-mail já cadastrado é recusado\", function () { pm.response.to.have.status(409); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Outra Ana\",\n  \"email\": \"ana@pda.org\",\n  \"password\": \"senha12345\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Conferir que só existe uma ana@pda.org",
              "event": [
                {
